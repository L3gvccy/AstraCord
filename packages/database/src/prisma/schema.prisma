generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  username      String
  globalName    String?
  discriminator String?
  avatar        String?
  banner        String?
  email         String?
  locale        String?
  verified      Boolean?
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WelcomeMessageCfg {
  id            String @id @default(uuid())
  guildId       String @unique

  isEnabled     Boolean @default(false)
  channelId     String

  isEmbed       Boolean

  message       String @default("Welcome, {user}!")

  title         String?

  color         String?
  displayAvatar Boolean @default(false)
  imageUrl      String?
}
