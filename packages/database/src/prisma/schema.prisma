generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CounterType{
TOTAL_USERS
USERS_ACTIVE
USERS_VOICE
BOTS
HUMANS
}

model User {
  id            String    @id
  username      String
  globalName    String?
  discriminator String?
  avatar        String?
  banner        String?
  email         String?
  locale        String?
  verified      Boolean?
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WelcomeMessageCfg {
  id      String @id @default(uuid())
  guildId String @unique

  isEnabled Boolean @default(false)
  channelId String?

  isEmbed Boolean @default(false)

  message String @default("Welcome, {user}!")

  title String?

  color         String? @default("#9b59b6")
  displayAvatar Boolean @default(false)
  imageUrl      String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @default(now())
}

model jtcConfig {
  id        String  @id @default(uuid())
  guildId   String  @unique
  isEnabled Boolean @default(false)

  channels jtcChannel[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model jtcChannel {
  id          String  @id @default(uuid())
  guildId     String
  channelId   String?
  categoryId  String?
  channelName String  @default("{username}'s channel")
  userLimit   Int     @default(0)

  config jtcConfig @relation(fields: [guildId], references: [guildId])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ServerStatsConfig{
  id String @id @default(uuid())
  guildId String @unique
  isEnabled Boolean @default(false)

  counters ServerStatsCounter[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ServerStatsCounter {
  id String @id @default(uuid())
  guildId String 
  channelId String?
  type CounterType?
  text String?

  config ServerStatsConfig @relation(fields: [guildId], references: [guildId])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TicketConfig {
  id String @id @default(uuid())
  guildId String @unique
  isEnabled Boolean @default(false)

  // Panel embed
  title String @default("Ticket system")
  description String @default("Select an option which fits your problem the most. The ticket will be created automatically.")
  color String @default("#9b59b6")
  thumbnailImageUrl String?
  imageUrl String?

  // Panel location
  channelId String?
  messageId String?

  // Category for created tickets
  categoryId String?

  options TicketOption[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TicketOption {
  id String @id @default(uuid())
  ticketConfigId String
  guildId String

  position Int

  // Select option
  optionEmoji String
  optionText String
  optionDescription String?

  // In-ticket message/embed
  isEmbed Boolean @default(true)

  title String? @default("Ticket opened")
  message String @default("Please describe your situation below")
  color String @default("#9b59b6")
  thumbnailImageUrl String?
  imageUrl String?

  roles TicketOptionRole[]

  ticketConfig TicketConfig @relation(fields: [ticketConfigId], references: [guildId], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TicketOptionRole {
  id String @id @default(uuid())
  ticketOptionId String
  roleId String

  ticketOption TicketOption @relation(fields: [ticketOptionId], references: [id], onDelete: Cascade)

  @@unique([ticketOptionId, roleId])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
